# MongoDB Atlas Database Connection String (Server-side only)
MONGODB_URI=

# Administrator Authentication (Required for single-tenant desk security)
# Production recommendation: pre-computed Scrypt hash (scrypt$v=1$N=16384,r=8,p=1$...)
ADMIN_PASSWORD_HASH=
# Local development only fallback:
ADMIN_PASSWORD=

# Cryptographic Session Signing Secret (Must be 32+ characters)
SESSION_SECRET=

# Optional: Local Server Port (Defaults to 3000)
PORT=3000
